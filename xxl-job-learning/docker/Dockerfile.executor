# 多阶段构建 Spring Boot 执行器
FROM maven:3.8-openjdk-8 AS builder

WORKDIR /app
COPY pom.xml .
COPY src ./src

# 构建项目
RUN mvn clean package -DskipTests

# 运行时镜像
FROM openjdk:8-jre-slim

WORKDIR /app

# 从构建阶段复制 jar 文件
COPY --from=builder /app/target/*.jar app.jar

# 暴露执行器端口
EXPOSE 9999

# 启动命令
ENTRYPOINT ["java", "-jar", "app.jar"]
